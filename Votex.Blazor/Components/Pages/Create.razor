@using Votex.Blazor.Models
@using Votex.Blazor.Services
@using Votex.Shared.DTO

@page "/create"
@inject Authenticator Authenticator
@inject IVotingsAPIService VotingsAPI
@inject IUserAPIService UsersAPI
@inject NavigationManager NavManager

<PageTitle>Create voting</PageTitle>

<Modal @ref=AddMiscUserModal Title="Add new user">
    <BodyTemplate>
        <div class="mb-3">
            <label for="miscUser" class="form-label">Haven't found a user in the list? Add a new user here</label>
            <input type="email" @bind="MiscUser" class="form-control" id="miscUser" placeholder="New user's email'" />
        </div>
        @if(ModalInputError)
        {
            <span class="text-danger">User e-mail needs to be unique and not empty!</span>
        }
    </BodyTemplate>
    <FooterTemplate>
        <input type="button" class="btn btn-primary" value="Add user" @onclick="AddMiscUserAsync" />
    </FooterTemplate>
</Modal>    

<Modal @ref=AddOptionModal Title="Add new option">
    <BodyTemplate>
        <div class="mb-3">
            <label for="newOption" class="form-label">New Option</label>
            <input type="text" @bind="NewOption" class="form-control" id="newOption" placeholder="New option's text'" />
        </div>
        @if (ModalInputError)
        {
            <span class="text-danger">The option field needs to be unique and not empty!</span>
        }
    </BodyTemplate>
    <FooterTemplate>
        <input type="button" class="btn btn-primary" value="Add option" id="addNewOption" @onclick="AddOptionAsync" />
    </FooterTemplate>
</Modal>

<AuthorizeView>
    <Authorized>
        <div class="card shadow-sm mt-4 col-sm-8 offset-sm-2">
            <div class="card-body">
                <h2 class="card-title mb-4">Create Voting</h2>
                @if(ErrorMessages.Count > 0)
                {
                    <div class="mb-3">
                        <ul class="list-group">
                            @foreach(var error in ErrorMessages)
                            {
                                <li class="list-group-item text-danger">@error</li>
                            }
                        </ul>
                    </div>
                }
                <div class="mb-3">
                    <label for="question" class="form-label">Question</label>
                    <input type="text" @bind="RequestDto.Question" class="form-control" id="question" placeholder="Enter a question for the voting" />
                </div>
                <div class="mb-3">
                    <label for="liveResults" class="form-label">Live Results</label>
                    <input type="checkbox" @bind="RequestDto.AreLiveResultsEnabled" class="form-check" id="liveResults"/>
                </div>
                <Grid TItem="string"
                      class="table table-bordered table-striped mb-3"
                      Data="UserEmails"
                      AllowPaging="true"
                      PageSize="5"
                      Responsive="true">
                    <GridColumns>
                        <GridColumn TItem="string" Context="user" HeaderText="User E-mail">@user</GridColumn>
                        <GridColumn TItem="string" Context="user" HeaderText="Add">
                            @if (RequestDto.UserEmails.Contains(user))
                            {
                                <input type="button" class="btn btn-danger" value="Remove" @onclick="() => RequestDto.UserEmails.Remove(user)" />
                            }
                            else
                            {
                                <input type="button" class="btn btn-primary" value="Add" @onclick="() => RequestDto.UserEmails.Add(user)" />
                            }
                        </GridColumn>
                    </GridColumns>
                </Grid>
                <div class="mb-3 row">
                    <div class="col-sm-6">
                        <label for="start" class="form-label">Start Date</label>
                        <input type="datetime" @bind="StartDate" class="form-control" id="start"/>
                    </div>
                    <div class="col-sm-6">
                        <label for="end" class="form-label">End Date</label>
                        <input type="datetime" @bind="EndDate" class="form-control" id="end" />
                    </div>
                </div>
                <label class="form-label">Add users not in the list / Add voting option</label>
                <div class="mb-3 row">
                    <div class="mb-3 col-sm-6">
                        <input type="button" class="btn btn-primary" value="Add new user" @onclick="AddMiscUserModal.ShowAsync" />
                    </div> 
                    <div class="mb-3 col-sm-6">
                        <input id="addOption" type="button" class="btn btn-primary" value="Add voting option" @onclick="AddOptionModal.ShowAsync" />
                    </div>
                </div>
                <div class="mb-3 row">
                    <div class="col-sm-6">
                        <h4>Current misc. users</h4>
                        <ul class="list-group">
                            @foreach (var user in RequestDto.UserEmails.Where(x => !UserEmails.Contains(x)))
                            {
                                <li class="list-group-item" @onclick="() => RequestDto.UserEmails.Remove(user)">@user</li>
                            }
                        </ul>
                    </div>
                    <div class="col-sm-6">
                        <h4>Current options</h4>
                        <ul class="list-group">
                            @foreach (var option in RequestDto.Options)
                            {
                                <li class="list-group-item" @onclick="() => RequestDto.Options.Remove(option)">@option</li>
                            }
                        </ul>
                    </div>
                </div>

                <button class="btn btn-primary mt-3" type="submit" @onclick="TryCreate">Create</button>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
