@using Votex.Blazor.Models
@using Votex.Blazor.Services
@using Votex.Shared.DTO

@page "/"
@inject Authenticator Authenticator
@inject IVotingsAPIService API
@inject NavigationManager NavManager

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Hello, @User.Email!</h1>
        <h3 class="mb-3">Welcome back to Votex!</h3>

        <div class="row mb-3">
            <div class="col-sm-4">
                <label for="question" class="form-label">Filter by question</label>
                <input id="question" type="text" class="form-control" placeholder="Start typing question" @bind=QuestionFilter/>
            </div>
            <div class="col-sm-4">
                <label for="start" class="form-label">Set start date</label>
                <input id="start" type="datetime" class="form-control" @bind=StartFilter />
            </div>
            <div class="col-sm-4">
                <label for="end" class="form-label">Set end date</label>
                <input id="end "type="datetime" class="form-control" @bind=EndFilter/>
            </div>
        </div>
        <input type="button" class="btn btn-primary mb-3" value="Filter" @onclick="() => FilterVotings(QuestionFilter, StartFilter, EndFilter)" />
        <Grid TItem="VotingListingRequestDto"
              class="table table-bordered table-striped"
              Data="@FilteredRequestDtos"
              AllowPaging="true"
              PageSize="5"
              Responsive="true">
            <GridColumns>
                <GridColumn TItem="VotingListingRequestDto" Context="voting" HeaderText="Question">@voting.Question</GridColumn>
                <GridColumn TItem="VotingListingRequestDto" Context="voting" HeaderText="Start Date">@voting.StartDate</GridColumn>
                <GridColumn TItem="VotingListingRequestDto" Context="voting" HeaderText="End Date">@voting.EndDate</GridColumn>
                <GridColumn TItem="VotingListingRequestDto" Context="voting" HeaderText="Vote">
                    @if (voting.AlreadyVoted)
                    {
                        <input type="button" class="btn btn-secondary" value="See current results" @onclick="() => GoToVotingResults(voting.Id)" />
                    }
                    else
                    {
                        <input type="button" class="btn btn-primary" value="Vote" @onclick="() => GoToVoting(voting.Id)" />
                    }
                </GridColumn>
            </GridColumns>
        </Grid>
    </Authorized>

    <NotAuthorized>
        <h1>Hello!</h1>
        <span>Welcome to Votex!</span>
        <div class="mt-3">
            <p class="mb-3">
                We believe every opinion matters—and should be shared freely and safely. Whether you’re making decisions in your team, planning an event, or collecting honest feedback, our platform lets you create and participate in fully anonymous votes with ease.
            </p>
            <ul class="list-group">
                <li class="list-group-item">
                    <b>100% Anonymous</b><br />
                    Your identity is never shared. Speak your mind without fear or pressure.
                </li>                
                <li class="list-group-item">
                    <b>Fast & Easy</b> <br />
                    Create a poll in seconds. You can invite your friends as well!
                </li>
                <li class="list-group-item">
                    <b>Real-Time Results</b> <br />
                    See live updates as votes come in. Transparent, trustworthy, and tamper-proof.
                </li>
            </ul>
        </div>
    </NotAuthorized>
</AuthorizeView>
